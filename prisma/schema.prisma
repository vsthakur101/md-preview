// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MarkdownFile {
  id         String            @id @default(cuid())
  title      String
  content    String            @db.Text
  preview    String
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null = private. When set, the file is publicly viewable at /share/{shareId}.
  shareId    String?           @unique
  // Pinned files surface first in the library.
  pinned     Boolean           @default(false)
  highlights Highlight[]
  reactions  Reaction[]
  progress   ReadingProgress[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Reading platform — reader engagement (per user, per file).
// ---------------------------------------------------------------------------

model Highlight {
  id        String       @id @default(cuid())
  fileId    String
  userId    String
  // Character offsets into the article's concatenated text content.
  startOff  Int
  endOff    Int
  text      String       @db.Text
  color     String       @default("yellow")
  // Optional reader annotation attached to the highlight.
  note      String?      @db.Text
  createdAt DateTime     @default(now())
  file      MarkdownFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId, userId])
}

// Server-synced scroll position (0..1) so reading resumes across devices.
// localStorage remains the fast path; this is the durable copy.
model ReadingProgress {
  id        String       @id @default(cuid())
  fileId    String
  userId    String
  fraction  Float        @default(0)
  updatedAt DateTime     @updatedAt
  file      MarkdownFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@index([userId])
}

model Reaction {
  id        String       @id @default(cuid())
  fileId    String
  userId    String
  paragraph Int
  type      String // 'heart' | 'idea'
  createdAt DateTime     @default(now())
  file      MarkdownFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId, paragraph, type])
  @@index([fileId, userId])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models. See https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  files         MarkdownFile[]
  highlights    Highlight[]
  reactions     Reaction[]
  progress      ReadingProgress[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
